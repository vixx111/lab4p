   "source": [
    "# 1. Сложить массивы №1, №2, №3 и умножить результат на скаляр 5\n",
    "res_sum_mul5 = ((arr1.astype(float) + arr2 + arr3) * 5.0).astype(float)\n",
    "# 2. Вычесть из массива №1 массив №2\n",
    "res_sub = (arr1.astype(float) - arr2).astype(float)\n",
    "# 3. Умножить массивы №1 и №3\n",
    "res_mul = (arr1.astype(float) * arr3).astype(float)\n",
    "# 4. Разделить массив №1 на массив №2\n",
    "res_div = (arr1.astype(float) / arr2).astype(float)\n",
    "# 5. Возвести элементы массива №1 в степень 3\n",
    "res_pow3 = (arr1.astype(float) ** 3.0).astype(float)\n",
    "print('1. (arr1 + arr2 + arr3) * 5 (первые 5 эл.):\\n', np.round(res_sum_mul5[:5], 3))\n",
    "print('\\n2. arr1 - arr2 (первые 5 эл.):\\n', np.round(res_sub[:5], 3))\n",
    "print('\\n3. arr1 * arr3 (первые 5 эл.):\\n', np.round(res_mul[:5], 3))\n",
    "print('\\n4. arr1 / arr2 (первые 5 эл.):\\n', np.round(res_div[:5], 3))\n",
    "print('\\n5. arr1 ** 3 (первые 5 эл.):\\n', np.round(res_pow3[:5], 3))"
