  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-10-30T08:44:45.511749Z",
     "start_time": "2026-10-30T08:44:45.504854Z"
    }
   },
   "source": [
    "col_names = ['Цена открытия', 'Минимальная цена', 'Максимальная цена', 'Цена закрытия', 'Средняя за день']\n",
    "min_vals = np.min(merged_prices, axis=0)\n",
    "max_vals = np.max(merged_prices, axis=0)\n",
    "mean_vals = np.mean(merged_prices, axis=0)\n",
    "var_vals = np.mean((merged_prices - mean_vals) ** 2, axis=0)\n",
    "std_vals = np.std(merged_prices, axis=0)\n",
    "rms_vals = np.sqrt(var_vals)\n",
    "cov_vals = rms_vals / mean_vals\n",
    "\n",
    "print(f\"{'Показатель':<36} | \" + \" | \".join([f\"{name[:7]:>7}\" for name in col_names]))\n",
    "print(\"-\" * 80)\n",
    "print(f\"{'Минимум':<36} | \" + \" | \".join([f\"{v:>7.2f}\" for v in min_vals]))\n",
    "print(f\"{'Максимум':<36} | \" + \" | \".join([f\"{v:>7.2f}\" for v in max_vals]))\n",
    "print(f\"{'Математическое ожидание':<36} | \" + \" | \".join([f\"{v:>7.2f}\" for v in mean_vals]))\n",
    "print(f\"{'Дисперсия':<36} | \" + \" | \".join([f\"{v:>7.2f}\" for v in var_vals]))\n",
    "print(f\"{'Стандартное отклонение (np.std)':<36} | \" + \" | \".join([f\"{v:>7.2f}\" for v in std_vals]))\n",
    "print(f\"{'СКО (sqrt из дисперсии)':<36} | \" + \" | \".join([f\"{v:>7.2f}\" for v in rms_vals]))\n",
    "print(f\"{'Коэффициент вариации (CV)':<36} | \" + \" | \".join([f\"{v:>7.4f}\" for v in cov_vals]))"
   ],
